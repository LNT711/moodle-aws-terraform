# Ignorar la carpeta de caché de Terraform
.terraform/

# Ignorar archivos de estado
*.tfstate
*.tfstate.*

# Variables con credenciales: nunca versionar (usar terraform.tfvars.example)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Lockfile (se puede regenerar)
.terraform.lock.hcl

# Archivos del plan
*.tfplan

# Archivos de backup
*.backup
crash.log

# Archivos de editores
.vscode/
.idea/
*.swp
.DS_Store

# Sistema
Thumbs.db
